DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Comma-separated hostnames the http_request node is allowed to call.
# Supports a *.example.com wildcard prefix. Empty/unset blocks every
# http_request URL by default (fails closed) — see DECISIONS.md.
ALLOWED_HTTP_DOMAINS=jsonplaceholder.typicode.com

# Sentry DSN for the backend project (create at sentry.io, platform "Node.js").
# Unset = Sentry.init never runs, no error reporting, everything else works
# unaffected. See web/.env.example for the separate frontend DSN.
SENTRY_DSN=
